# Copy to `.env` (gitignored) and adjust. This is the ONLY file that should
# differ between your laptop and a real host -- everything else in this
# directory is meant to be deployed verbatim.
#
# The values below are deliberately working defaults so the lab comes up with
# no editing. They are lab credentials: do not reuse them anywhere real.

# ---------------------------------------------------------------------------
# Host paths. Relative paths are resolved against this directory; absolute
# paths are what you would use on a real host, e.g.
#   HOST_DATA_DIR=/srv/holdenweb/data
#   HOST_LOG_DIR=/var/log/holdenweb
# ---------------------------------------------------------------------------
HOST_DATA_DIR=./hostdata
HOST_LOG_DIR=./hostlogs

# ---------------------------------------------------------------------------
# Ports published on the host (loopback only -- see compose.yaml).
# ---------------------------------------------------------------------------

# Both are deliberately offset by one from the ports the real site uses
# locally (8456 for the app, 27017 for a natively installed mongod), so this
# lab can run alongside them and you can never mistake one for the other.
WEB_HOST_PORT=8457
MONGO_HOST_PORT=27018

# ---------------------------------------------------------------------------
# MongoDB. The root credentials are used once, by the image's first-run
# bootstrap, to create the far less privileged application user that Flask
# actually connects with.
# ---------------------------------------------------------------------------
MONGO_ROOT_USER=labroot
MONGO_ROOT_PASSWORD=labroot-password
MONGO_DB=holdenweb
MONGO_APP_USER=holdenweb_app
MONGO_APP_PASSWORD=holdenweb-app-password

# ---------------------------------------------------------------------------
# Flask.
# ---------------------------------------------------------------------------
SECRET_KEY=lab-only-secret-key
GUNICORN_WORKERS=2
