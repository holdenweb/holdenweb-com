# Per-host deployment settings. Copy to `.env` (gitignored) and adjust.
#
# Everything here is **expected to differ between hosts** and is meant to be
# edited when you stand the site up somewhere new. Nothing here is a secret,
# and nothing here has to survive a restore unchanged. Its counterpart is
# `secrets.env`, which is the opposite on both counts: every value there must
# be restored *verbatim* or the site loses access to its own data.
#
# This is the only file compose reads for substitution, so no credential
# appears in it. (`podman compose config` still prints them, since it expands
# env_file contents -- treat its output as sensitive.)

# ---------------------------------------------------------------------------
# What this deployment is called. Names the compose project and the image, so
# two sites on one host cannot collide. Keep it in step with `name` in
# config/app.toml -- compose cannot read TOML, which is the only reason the
# site's name is written twice.
# ---------------------------------------------------------------------------
SITE_NAME=holdenweb-com

# ---------------------------------------------------------------------------
# Host paths. Relative paths resolve against this directory; on a real host
# they become absolute, e.g.
#   HOST_DATA_DIR=/srv/holdenweb/data
#   HOST_LOG_DIR=/var/log/holdenweb
# On Opalstack these live under the proxy-port application's directory,
# ~/apps/<app-name>/.
# ---------------------------------------------------------------------------
HOST_DATA_DIR=./hostdata
HOST_LOG_DIR=./hostlogs

# ---------------------------------------------------------------------------
# Ports published on the host. Offset from everything already spoken for on
# this machine: 8456 (the old production container), 8457 (MongoDB lab),
# 8458 (podpack's own lab), 8459 (podpack-demo), 8460 (scripts/devserver.py),
# 5432 (native PostgreSQL) and 5433 (podpack's lab database).
#
# WEB_HOST_PORT is the one setting a managed host dictates: an Opalstack
# "Nginx Proxy Port" application is given a port and the site is proxied
# there, so deploying is a matter of putting that number here.
# ---------------------------------------------------------------------------
WEB_HOST_PORT=8461
WEB_BIND_ADDR=127.0.0.1
POSTGRES_HOST_PORT=5434

# ---------------------------------------------------------------------------
# Tuning.
# ---------------------------------------------------------------------------
GUNICORN_WORKERS=2

# ---------------------------------------------------------------------------
# Local development outside containers: scripts/devserver.py sets its own
# environment (SQLite, throwaway secrets) and runs on port 8460. It reads
# nothing from this file.
# ---------------------------------------------------------------------------
