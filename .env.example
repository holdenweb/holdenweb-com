# Copy to `.env` and fill in real values. `.env` is gitignored.
# The `export` prefix lets you `. .env` in a shell as well as have
# python-dotenv / docker compose load it.

export OPALSTACK_TOKEN=CHANGEME
export DBNAME=holdenweb
export SECURITY_PASSWORD_SALT=CHANGEME
export SQLALCHEMY_DATABASE_URI=postgresql+psycopg2://hweb_auth_user:CHANGEME@localhost/holdenweb
export MAIL_PASSWORD="CHANGEME"
export SECRET_KEY="CHANGEME"

# Password only, used by docker-compose.yml to build the container-side
# override URI that points at host.docker.internal. Keep in sync with
# the password embedded in SQLALCHEMY_DATABASE_URI above.
export POSTGRES_PASSWORD=CHANGEME

# Content topology (see README: "Content topology"). Unset in local dev
# to read HTML/MD from the package's data/ directory. Set in production
# to point at the content static apps -- BOTH must then be set, or the
# app refuses to boot.
# export CONTENT_BASE_URL=https://holdenweb.com/content
# export CONTENT_ACCESS_TOKEN=CHANGEME

# Optional content-fetch tuning; defaults shown.
# export CONTENT_HTTP_TIMEOUT=5.0
# export CONTENT_CACHE_TTL=300
# export CONTENT_ASSET_CACHE_TTL=3600

# Optional: only if your editor / IDE needs it.
# export WINGHOME="/Applications/Wing Pro.app/Contents/Resources"
