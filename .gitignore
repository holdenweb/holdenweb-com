stop
version.txt
version.py
release-*.tgz

# podpack per-app data and logs (seeded/created at boot; never committed)
hostdata/
hostlogs/
secrets.env

# Personal working scripts -- experiments, one-off utilities, session notes.
# Deliberately outside scripts/, which holds only podpack's substrate files:
# `podpack substrate` walks a manifest and never sweeps a directory, but a
# mixed directory is still an invitation to a mistake nobody needs.
scratch/

# The local, container-free run: dev.env holds a database password, and the
# roots hold app data written by your own uid. In podpack the seeded
# .gitignore names these; added by hand because a seeded file is never
# revisited (ADR-0026).
dev.env
devdata/
devlogs/

# Backups, if BACKUP_ROOT is ever pointed inside the tree. They contain
# secrets.env in clear.
backups/

# What scripts/restore.sh sets aside before replacing them. secrets.env is
# among them, in clear, so this matters more than the tidiness suggests.
# Copied by hand from podpack's seed: seeded files never upgrade (ADR-0026).
*.superseded-*
